# Supabase(PostgreSQL) 연결 문자열.
# 설정하면 Postgres를, 비워 두면 로컬 SQLite(instance/delivery.db)를 사용한다.
# Supabase 대시보드 > Connect > Transaction pooler 의 URI 를 넣는다.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 세션 쿠키 서명 키. 없으면 서버리스 인스턴스가 재시작될 때마다 로그인이 풀린다.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
